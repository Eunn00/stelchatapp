{
  "name": "stelchat-desktop",
  "version": "0.1.10",
  "description": "StelChat Windows companion",
  "main": "main.cjs",
  "author": "StelChat",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --test notification-policy.test.cjs external-link-policy.test.cjs",
    "smoke": "node smoke.cjs",
    "icon": "node make-icon.cjs",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "xyz.stelchat.desktop",
    "productName": "StelChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "external-link-policy.cjs",
      "notification-policy.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "styles.css",
      "THIRD_PARTY_NOTICES.md",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "portable"
      ],
      "artifactName": "StelChat-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
